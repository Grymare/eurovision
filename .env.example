# Copy to `.env.local` for local development, or set in Docker / production.

# Node environment (use production for Docker / public hosting)
NODE_ENV=production

# SQLite database path (Docker default uses the named volume mount)
DATABASE_PATH=./data/app.db

# Public URL for documentation and future features (optional today)
PUBLIC_APP_URL=https://eurovision.grymare.com

# Server bind (Docker sets these automatically)
HOSTNAME=0.0.0.0
PORT=3000
