# Copy to `.env.local` for local development, or set in Docker / production.

# Node environment (use production for Docker / public hosting)
NODE_ENV=production

# SQLite database path (Docker default uses the named volume mount)
DATABASE_PATH=./data/app.db

# Public URL for join links and Auth.js callbacks
PUBLIC_APP_URL=https://eurovision.grymare.com
AUTH_URL=https://eurovision.grymare.com

# Auth.js — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Comma-separated emails allowed to create parties (site admin)
ADMIN_EMAILS=you@example.com

# Google OAuth (optional)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Magic link + password reset (optional — enables “Email me a link” and “Forgot password?”)
# Without both vars, those login options stay hidden.
#
# Resend (verify your domain in the Resend dashboard first):
# EMAIL_SERVER=smtp://resend:re_YOUR_API_KEY@smtp.resend.com:587
# EMAIL_FROM=Grymare Eurovision <noreply@grymare.com>
#
# Gmail app password alternative:
# EMAIL_SERVER=smtp://you@gmail.com:YOUR_APP_PASSWORD@smtp.gmail.com:587
# EMAIL_FROM=you@gmail.com

# Eurovision year datasets (optional override; Docker default uses eurovision-datasets volume)
# EUROVISION_DATASETS_DIR=./data/eurovision
HOSTNAME=0.0.0.0
PORT=3000
